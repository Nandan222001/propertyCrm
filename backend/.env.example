# =============================================================================
# Lalita Realestate Infra ERP — environment template
# -----------------------------------------------------------------------------
# Copy to `backend/.env` for local work:  cp backend/.env.example backend/.env
# NEVER commit a real .env. In staging/production every value below is injected
# from the platform's secret manager (AWS Secrets Manager / K8s Secret / Vercel
# env), not from a file on disk.
# =============================================================================

# --- application -------------------------------------------------------------
APP_NAME="Property ERP API"
BRAND_NAME="Lalita Realestate Infra"          # shown on the sign-in page
BRAND_TAGLINE="Enterprise real estate operations"
# SUPPORT_EMAIL=it@your-domain.com
APP_VERSION=1.0.0
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=false                       # must stay false outside local
API_V1_PREFIX=/api/v1

# Comma-separated list (or JSON array). Wildcards are rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.e2b.app
TRUSTED_PROXIES=                  # exact proxy IPs, never a CIDR you do not own
MAX_REQUEST_BYTES=2097152         # 2 MB request body cap -> 413 beyond this

# --- database ----------------------------------------------------------------
DB_DIALECT=mysql                  # mysql | sqlite (sqlite is for tests/demos only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lalita_erp
DB_USER=lalita_app                # least-privilege runtime user, see scripts/create_db.sql
DB_PASSWORD=                      # REQUIRED in production (injected by secret manager)
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL_MODE=verify_identity       # disabled | preferred | required | verify_identity
DB_SSL_CA=/etc/ssl/certs/rds-ca-global-bundle.pem
# SQLITE_PATH=var/lalita_erp.sqlite3

# --- authentication / crypto -------------------------------------------------
# 32+ random bytes: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=
INDEX_PEPPER=                     # peppered blind indexes for e-mail/mobile lookups
FIELD_ENCRYPTION_KEY=             # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10
PASSWORD_HASH_ROUNDS=12
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# --- rate limiting / abuse control -------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis          # memory is single-process only; redis for clusters
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WRITE=120/minute

# --- transport / headers -----------------------------------------------------
FORCE_HTTPS=true                  # TLS terminates at the ALB; app still redirects
SECURITY_HEADERS_ENABLED=true
CSP_POLICY="default-src 'none'; frame-ancestors 'none'; base-uri 'none'"

# --- logging / audit ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true                     # JSON logs for CloudWatch/Datadog ingestion
AUDIT_LOG_ENABLED=true
AUDIT_SEPARATE_SESSION=true       # security telemetry survives request rollback
SECURITY_ALERTS_ENABLED=true

# --- privacy / retention -----------------------------------------------------
PII_MASK_BY_DEFAULT=true
CONSENT_REQUIRED=true
DATA_RETENTION_DAYS=2555          # 7 years — statutory books of account
AUDIT_RETENTION_DAYS=3650         # 10 years — security evidence

# --- outgoing e-mail (password reset) — Gmail SMTP --------------------------
# Sends from the company Gmail account. SMTP_PASSWORD is a Gmail *app password*
# (Google Account > Security > 2-Step Verification > App passwords) — paste it
# into your own backend/.env only; never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reallifecity77@gmail.com
SMTP_PASSWORD=                    # <- put the Gmail app password here (in .env, not here)
SMTP_FROM=reallifecity77@gmail.com
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:5173   # reset links point here (use the real site address in production)
# RESEND_API_KEY=                  # optional alternative; when set it is used instead of SMTP — leave unset for Gmail
